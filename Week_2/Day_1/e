Q1.VALID ANAGRAM
code:

class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.size()!=t.size()) return false;
        sort(s.begin(),s.end());
        sort(t.begin(),t.end());
        if(s==t) return true;
        return false;
        
    }
};



Q2.FIND UNIQUE CHARACTER IN A STRING
code;

class Solution {
public:
    int firstUniqChar(string s) {
        map<char,int>m;
        for(int i=0;i<s.size();i++)  m[s[i]]++;
        for(int i=0;i<s.size();i++){
            if(m[s[i]]==1)
             return i;
        }
        return -1;
        
    }
};



Q3.RANSOM NOTE
code:

class Solution {
public:
    bool canConstruct(string rN, string mg) {
        map<char,int>m;
        for(int i=0;i<mg.size();i++) m[mg[i]]++;
        for(int i=0;i<rN.size();i++){
            if(m[rN[i]]>0) m[rN[i]]--;
            else return false;
        }
        return true;
        
    }
};
