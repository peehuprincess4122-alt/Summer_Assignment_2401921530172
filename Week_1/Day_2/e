Q1.MAXIMUM SUBARRAY
code:

class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int prefix=0;
        int maxi=INT_MIN;
        for(int i=0;i<nums.size();i++){
            prefix+=nums[i];
            maxi=max(maxi,prefix);
            if(prefix<0)
             prefix=0;
        }
        return maxi;
        
    }
};



Q2.CONTAINS DUPLICATE 
code:

class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        for(int i=0;i<nums.size()-1;i++){
            if(nums[i]==nums[i+1]){
                return true;
            }
        }
        return false;
        
    }
};



Q3.MAXIMUM AVERAGE SUBARRAY I
code:

class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int s=0;double maxi;
         for(int i=0;i<k;i++){
            s+=nums[i];
         }maxi=s;
         for(int i=k;i<nums.size();i++){
            s=s-nums[i-k];
            s=s+nums[i];
            if(s>maxi) maxi=s;
         }  
         return maxi/k;
        
    }
};
