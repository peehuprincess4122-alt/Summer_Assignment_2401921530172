 Q3.NEXT GREATER ELEMENT I
 code:

 class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& n1, vector<int>& n2) {
        map<int,int>m;
        stack<int>s;
        for(int i=n2.size()-1;i>=0;i--){
            int ele = n2[i];
            if(s.empty())
            {
                m[ele]=-1;
            }
            else{
                if(s.top()>ele){
                    m[ele]=s.top();
                }
                else{
                    while(!s.empty()){
                        if(s.top()>ele){
                            m[ele]=s.top();
                            break;
                        }
                        s.pop();
                    }
                    if(s.empty()){
                        m[ele]=-1;
                    }
                }
            }
            s.push(ele);
        }
        vector<int> r;
        for(auto i: n1){
         r.push_back(m[i]);
        } 
        return r;
    }                
};
